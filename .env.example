NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://lunaris:lunaris_local_only@localhost:5434/lunaris
TEST_DATABASE_URL=postgresql://lunaris:lunaris_local_only@localhost:5435/lunaris_test
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:4000
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=info
# Optional, development seed only. Never use this password in production.
SEED_PASSWORD=Local-demo-password-2026!

# Optional locally; configure both with a verified sender for public launch.
# RESEND_API_KEY=re_replace_with_provider_key
# EMAIL_FROM=accounts@your-domain.example
EXPIRY_SWEEP_INTERVAL_MS=60000
